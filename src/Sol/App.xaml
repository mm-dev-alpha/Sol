<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Sol.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sol"
    xmlns:converters="using:Sol.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
            <converters:BoolToRedBrushConverter x:Key="BoolToRedBrushConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <converters:AccountStatusBrushConverter x:Key="AccountStatusBrushConverter"/>
            
            <!-- Fluent 2 Geometry &amp; Corner Radii (DESIGN_PHILOSOPHY.md §2.2) -->
            <CornerRadius x:Key="ControlCornerRadius">4,4,4,4</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">8,8,8,8</CornerRadius>

            <!-- Monospace Font Family Reference -->
            <FontFamily x:Key="CodeFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>

            <!-- Subtle Icon Button Style -->
            <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>