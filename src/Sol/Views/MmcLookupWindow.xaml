<Window
    x:Class="Sol.Views.MmcLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:helpers="using:Sol.Helpers"
    mc:Ignorable="d"
    Title="Sol">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Window Icon and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74C;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind S.MmcWindowLauncherTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Result Count Badge -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ItemCountText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <!-- Keyboard Hints -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,130,0">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock Text="{x:Bind S.MmcHintEnter}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock Text="{x:Bind S.MmcHintCtrlC}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock Text="{x:Bind S.MmcHintEsc}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Search & Category Filter Header -->
        <Grid Grid.Row="1" Padding="20,6,20,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="{x:Bind S.MmcSearchPlaceholder}"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"
                     HorizontalAlignment="Stretch" />

            <ComboBox x:Name="CategoryCombo"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="CategoryCombo_SelectionChanged">
                <ComboBoxItem Content="{x:Bind S.MmcCategoryAll}" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="{x:Bind S.MmcCategoryActiveDirectory}" Tag="ActiveDirectory" />
                <ComboBoxItem Content="{x:Bind S.MmcCategoryManagement}" Tag="Management" />
                <ComboBoxItem Content="{x:Bind S.MmcCategoryDiagnostics}" Tag="Diagnostics" />
                <ComboBoxItem Content="{x:Bind S.MmcCategorySecurity}" Tag="Security" />
                <ComboBoxItem Content="{x:Bind S.MmcCategoryNetworking}" Tag="Networking" />
                <ComboBoxItem Content="{x:Bind S.MmcCategoryStorage}" Tag="Storage" />
                <ComboBoxItem Content="{x:Bind S.MmcCategorySystem}" Tag="System" />
            </ComboBox>
        </Grid>

        <!-- Status / Feedback Toast Pill -->
        <Border x:Name="FeedbackPill"
                Grid.Row="2"
                Margin="20,0,20,8"
                Padding="12,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="FeedbackText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Results List Area -->
        <Grid Grid.Row="3" Padding="20,0,20,16">
            <ListView x:Name="ToolsListView"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="ToolsListView_ItemClick"
                      KeyDown="ToolsListView_KeyDown"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MmcToolItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="12,8"
                                Margin="0,2">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Favorite Star Button -->
                                <Button Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="FavoriteButton_Click"
                                        Tag="{x:Bind Id}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}"
                                              FontSize="13"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Button>

                                <!-- Tool Category Icon -->
                                <FontIcon Grid.Column="1"
                                          Glyph="{x:Bind Glyph}"
                                          FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="2,0,4,0" />

                                <!-- Main Details -->
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FullRunCommand}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       FontFamily="{StaticResource CodeFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Category Badge -->
                                <Border Grid.Column="3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Margin="4,0">
                                    <TextBlock Text="{x:Bind CategoryDisplayName}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Click="CopyCommandButton_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind helpers:Strings.S.MmcCopyCommandButton}"
                                            Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            <TextBlock Text="{x:Bind helpers:Strings.S.MmcCopyCommandButton}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="LaunchButton_Click"
                                            Tag="{x:Bind}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind helpers:Strings.S.MmcLaunchButton}"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock Text="{x:Bind helpers:Strings.S.MmcLaunchButton}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind S.MmcNoResults}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
