<Window
    x:Class="Sol.Views.ServicesInspectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:helpers="using:Sol.Helpers"
    mc:Ignorable="d"
    Title="Sol">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE770;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3">
                    <TextBlock Text="{x:Bind ViewModel.TotalServicesCountBadge, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Padding="20,10,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Top Controls Bar: Filter Tabs + SearchBox + Refresh Button -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Filter Tabs (All / Running / Stopped) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAllRadio" 
                                 Content="{x:Bind helpers:Strings.S.ServiceFilterAll}" 
                                 GroupName="ServiceStatusFilter"
                                 IsChecked="True" 
                                 Click="FilterRadio_Click" 
                                 Tag="All"/>
                    <RadioButton x:Name="FilterRunningRadio" 
                                 Content="{x:Bind helpers:Strings.S.ServiceFilterRunning}" 
                                 GroupName="ServiceStatusFilter" 
                                 Click="FilterRadio_Click" 
                                 Tag="Running"/>
                    <RadioButton x:Name="FilterStoppedRadio" 
                                 Content="{x:Bind helpers:Strings.S.ServiceFilterStopped}" 
                                 GroupName="ServiceStatusFilter" 
                                 Click="FilterRadio_Click" 
                                 Tag="Stopped"/>
                </StackPanel>

                <!-- Search Filter Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         PlaceholderText="{x:Bind helpers:Strings.S.SearchServicesPlaceholder}"
                         Text="{x:Bind ViewModel.ServiceFilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged"
                         HorizontalAlignment="Stretch" />

                <!-- Dedicated Refresh Button -->
                <Button Grid.Column="2"
                        Click="RefreshBtn_Click"
                        ToolTipService.ToolTip="{x:Bind helpers:Strings.S.RefreshBtn}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="{x:Bind helpers:Strings.S.RefreshBtn}" Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Interactive Column Headers (Clickable for Sorting) -->
            <!-- Order: Display Name (2.2*), Service Name (1.3*), Status (110), Startup Type (140), Log On As (1.3*), Actions (130) -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <!-- Display Name -->
                    <Button Grid.Column="0" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="DisplayName" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ServiceDisplayNameCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_DisplayName" Text="▲" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Service Name -->
                    <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="Name" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ServiceNameCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_Name" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Status -->
                    <Button Grid.Column="2" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="Status" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ServiceStatusCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_Status" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Startup Type -->
                    <Button Grid.Column="3" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="StartMode" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ServiceStartupTypeCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_StartMode" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Log On As -->
                    <Button Grid.Column="4" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="StartName" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ServiceLogOnAsCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_StartName" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Action Column Header -->
                    <TextBlock Grid.Column="5" Text="{x:Bind helpers:Strings.S.ServiceActionsCol}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                </Grid>
            </Border>

            <!-- 3. Services Items ListView -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.FilteredServices, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ComputerServiceInfo">
                            <Grid Padding="8,4" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Display Name + Description Tooltip -->
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Description}">
                                    <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind PathName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Column 1: Service Name -->
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource CodeFontFamily}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                <!-- Column 2: Status Pill -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Running State Pill -->
                                    <Border Visibility="{x:Bind RunningVisibility}"
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind StatusDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stopped State Pill -->
                                    <Border Visibility="{x:Bind StoppedVisibility}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2">
                                        <TextBlock Text="{x:Bind StatusDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>

                                    <!-- Pending / Other State Pill -->
                                    <Border Visibility="{x:Bind PendingVisibility}"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE712;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind State}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Column 3: Startup Type ComboBox -->
                                <ComboBox Grid.Column="3"
                                          Tag="{x:Bind}"
                                          SelectedIndex="{x:Bind StartModeIndex}"
                                          IsEnabled="{x:Bind CanChangeStartMode}"
                                          DropDownClosed="StartModeCombo_DropDownClosed"
                                          Width="125"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{x:Bind StartModeAutoDisplay}" Tag="Auto" />
                                    <ComboBoxItem Content="{x:Bind StartModeManualDisplay}" Tag="Manual" />
                                    <ComboBoxItem Content="{x:Bind StartModeDisabledDisplay}" Tag="Disabled" />
                                </ComboBox>

                                <!-- Column 4: Log On As -->
                                <TextBlock Grid.Column="4" Text="{x:Bind DisplayStartName}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                <!-- Column 5: Action Buttons (Start, Stop, Restart) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Start Button -->
                                    <Button Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanStart}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind StartTooltip}"
                                            Click="StartService_Click"
                                            Padding="6,4">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Button>

                                    <!-- Stop Button -->
                                    <Button Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanStop}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind StopTooltip}"
                                            Click="StopService_Click"
                                            Padding="6,4">
                                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>

                                    <!-- Restart Button -->
                                    <Button Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanRestart}"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind RestartTooltip}"
                                            Click="RestartService_Click"
                                            Padding="6,4">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>

                                    <!-- Shield icon indicator for Critical Services -->
                                    <Border Visibility="{x:Bind CriticalVisibility}"
                                            ToolTipService.ToolTip="{x:Bind CriticalProtectedTooltip}"
                                            Padding="4,2">
                                        <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
