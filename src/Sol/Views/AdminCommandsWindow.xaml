<Window
    x:Class="Sol.Views.AdminCommandsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:helpers="using:Sol.Helpers"
    mc:Ignorable="d"
    Title="Sol">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Window Icon and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind S.AdminCommandsWindowLauncherTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Result Count Badge -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ItemCountText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <!-- Keyboard Hints -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,130,0">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock Text="{x:Bind S.AdminCommandsHintEnter}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,3">
                    <TextBlock Text="{x:Bind S.AdminCommandsHintEsc}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Search & Filter Header -->
        <Grid Grid.Row="1" Padding="20,6,20,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="{x:Bind S.AdminCommandsSearchPlaceholder}"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"
                     HorizontalAlignment="Stretch" />

            <ComboBox x:Name="ShellFilterCombo"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="{x:Bind S.AdminCommandsFilterAllShells}" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsFilterPowerShell}" Tag="PowerShell" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsFilterCmd}" Tag="Cmd" />
            </ComboBox>

            <ComboBox x:Name="CategoryFilterCombo"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryAll}" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryActiveDirectory}" Tag="ActiveDirectory" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryNetworking}" Tag="Networking" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryGroupPolicy}" Tag="GroupPolicy" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryDiagnostics}" Tag="Diagnostics" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategorySecurity}" Tag="Security" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryRemoteManagement}" Tag="RemoteManagement" />
                <ComboBoxItem Content="{x:Bind S.AdminCommandsCategoryStorage}" Tag="Storage" />
            </ComboBox>
        </Grid>

        <!-- Feedback Toast Pill -->
        <Border x:Name="FeedbackPill"
                Grid.Row="2"
                Margin="20,0,20,8"
                Padding="12,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="FeedbackText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           FontWeight="Medium"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Results List Area -->
        <Grid Grid.Row="3" Padding="20,0,20,16">
            <ListView x:Name="CommandsListView"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="CommandsListView_ItemClick"
                      KeyDown="CommandsListView_KeyDown"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdminCommandItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="12,8"
                                Margin="0,2">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Favorite Star Button -->
                                <Button Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="FavoriteButton_Click"
                                        Tag="{x:Bind Id}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}"
                                              FontSize="13"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Button>

                                <!-- Shell Badge -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ShellBadgeText}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="Bold"
                                               FontSize="10"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Main Details -->
                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="8,4">
                                        <TextBlock Text="{x:Bind Command}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   FontFamily="{StaticResource CodeFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Category Badge -->
                                <Border Grid.Column="3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Margin="4,0">
                                    <TextBlock Text="{x:Bind CategoryDisplayName}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Copy Action Button -->
                                <Button Grid.Column="4"
                                        Click="CopyButton_Click"
                                        Tag="{x:Bind}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind helpers:Strings.S.AdminCommandsCopyButton}"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                        <TextBlock Text="{x:Bind helpers:Strings.S.AdminCommandsCopyButton}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind S.AdminCommandsNoResults}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
