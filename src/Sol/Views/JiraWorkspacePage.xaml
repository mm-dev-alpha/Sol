<Page
    x:Name="PageRoot"
    x:Class="Sol.Views.JiraWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:viewmodels="using:Sol.ViewModels"
    xmlns:local="using:Sol.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Empty State Hero Card (When no user is loaded) -->
        <Grid Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              MaxWidth="720" Margin="24">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="44,36">
                <StackPanel Spacing="22" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/JiraLogo.png" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{x:Bind S.JiraWorkspaceTitle}" 
                               Style="{ThemeResource TitleLargeTextBlockStyle}" 
                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    
                    <!-- Search Users Box -->
                    <AutoSuggestBox PlaceholderText="{x:Bind S.SearchUserForJiraPlaceholder}" 
                                    Text="{x:Bind ViewModel.CenterSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{x:Bind ViewModel.CenterSuggestions, Mode=OneWay}"
                                    TextChanged="CenterSearchBox_TextChanged"
                                    QuerySubmitted="CenterSearchBox_QuerySubmitted"
                                    SuggestionChosen="CenterSearchBox_SuggestionChosen"
                                    Width="540"
                                    HorizontalAlignment="Center"
                                    UpdateTextOnSelect="False">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon Glyph="&#xE77B;"/>
                        </AutoSuggestBox.QueryIcon>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AdUser">
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                    <PersonPicture DisplayName="{x:Bind DisplayName}" Width="28" Height="28"/>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SamAccountName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Loaded Workspace Content -->
        <ScrollViewer Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                      Padding="24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- Quick Command Bar -->
                <CommandBar DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton Icon="Refresh" Label="{x:Bind S.RefreshJiraBtn}" Command="{x:Bind ViewModel.RefreshTicketsCommand}"/>
                    <AppBarSeparator/>
                    <AppBarButton Icon="Home" Label="{x:Bind S.CloseWorkspaceBtn}" Command="{x:Bind ViewModel.ResetToSearchStateCommand}"/>
                </CommandBar>

                <!-- HERO HEADER CARD -->
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource CardCornerRadius}"
                      Padding="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PersonPicture Grid.Column="0" DisplayName="{x:Bind ViewModel.CurrentUser.DisplayName, Mode=OneWay}" Width="64" Height="64" Margin="0,0,20,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CurrentUser.DisplayName, Mode=OneWay}" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.CurrentUser.SamAccountName, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentUser.Email, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ticket Count Pill -->
                    <Border Grid.Column="2" 
                            Background="{ThemeResource AccentFillColorDefaultBrush}" 
                            CornerRadius="14" 
                            Padding="12,6" 
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TicketCountBadge, Mode=OneWay}" 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- TICKETS SECTION -->
                <StackPanel Spacing="12">
                    <!-- Filter and Action Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 PlaceholderText="{x:Bind S.JiraFilterPlaceholder}"
                                 Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="420"
                                 HorizontalAlignment="Left">
                            <TextBox.Header>
                                <TextBlock Text="{x:Bind S.JiraTicketsSectionTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            </TextBox.Header>
                        </TextBox>

                        <Button Grid.Column="1" 
                                Style="{StaticResource SubtleIconButtonStyle}"
                                Command="{x:Bind ViewModel.RefreshTicketsCommand}"
                                ToolTipService.ToolTip="{x:Bind S.RefreshJiraBtn}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Loading State -->
                    <controls:SettingsCard Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing IsActive="True" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind S.FetchingJiraTickets}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>

                    <!-- Error State -->
                    <controls:SettingsCard Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>

                    <!-- Empty Tickets State -->
                    <controls:SettingsCard Visibility="{x:Bind ViewModel.HasNoTickets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind S.NoJiraTicketsForUser}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </controls:SettingsCard>

                    <!-- Tickets Table Container -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource CardCornerRadius}"
                            Visibility="{x:Bind ViewModel.HasTickets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Table Header -->
                            <Grid Padding="16,12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind S.JiraKeyColumn}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind S.JiraStatusColumn}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind S.JiraSummaryColumn}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind S.JiraPriorityColumn}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind S.JiraCreatedColumn}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>

                            <!-- Tickets List -->
                            <ListView ItemsSource="{x:Bind ViewModel.FilteredTickets, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:JiraTicket">
                                        <Grid Padding="16,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Key (Hyperlink to JIRA) -->
                                            <HyperlinkButton Grid.Column="0" 
                                                             NavigateUri="{x:Bind BrowseUrl}"
                                                             Padding="0" 
                                                             VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11"/>
                                                    <TextBlock Text="{x:Bind Key}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </HyperlinkButton>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="1" 
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="8,2" 
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Status}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                            </Border>

                                            <!-- Summary -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{x:Bind Summary}" 
                                                       Style="{ThemeResource BodyTextBlockStyle}" 
                                                       VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Padding="0,0,12,0"/>

                                            <!-- Priority -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{x:Bind Priority}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Created Date -->
                                            <TextBlock Grid.Column="4" 
                                                       Text="{x:Bind FormattedCreated}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Load More Button -->
                            <Button Content="{x:Bind S.LoadMoreBtn}"
                                    Command="{x:Bind ViewModel.LoadMoreTicketsCommand}"
                                    Visibility="{x:Bind ViewModel.HasMoreTickets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,16"
                                    Style="{ThemeResource DefaultButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
