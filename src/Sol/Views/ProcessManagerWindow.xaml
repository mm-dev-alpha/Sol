<Window
    x:Class="Sol.Views.ProcessManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:helpers="using:Sol.Helpers"
    mc:Ignorable="d"
    Title="Sol">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TitleTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3">
                    <TextBlock Text="{x:Bind ViewModel.TotalProcessesCountBadge, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Padding="20,10,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Top Controls Bar -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         PlaceholderText="{x:Bind helpers:Strings.S.SearchProcessesPlaceholder}"
                         Text="{x:Bind ViewModel.ProcessFilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged"
                         HorizontalAlignment="Stretch" />

                <Button Grid.Column="1"
                        Click="RefreshBtn_Click"
                        ToolTipService.ToolTip="{x:Bind helpers:Strings.S.RefreshBtn}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="{x:Bind helpers:Strings.S.RefreshBtn}" Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Interactive Column Headers (Clickable for Sorting) -->
            <!-- Order: PID, Name, User, CPU, Memory, Network, Action -->
            <Border Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <!-- PID -->
                    <Button Grid.Column="0" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="PID" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.PidHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_PID" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Process Name -->
                    <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="Name" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.ProcessNameHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_Name" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- User -->
                    <Button Grid.Column="2" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="User" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind helpers:Strings.S.UserHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_User" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- CPU -->
                    <Button Grid.Column="3" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Click="SortColumn_Click" Tag="CPU" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind helpers:Strings.S.CpuHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_CPU" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Memory -->
                    <Button Grid.Column="4" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Click="SortColumn_Click" Tag="Memory" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind helpers:Strings.S.MemoryHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_Memory" Text="▼" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Network -->
                    <Button Grid.Column="5" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Click="SortColumn_Click" Tag="Network" Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind helpers:Strings.S.NetworkHeader}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SortIcon_Network" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Action Column Header -->
                    <TextBlock Grid.Column="6" Text="" />
                </Grid>
            </Border>

            <!-- 3. Process Items ListView -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.FilteredProcesses, Mode=OneWay}"
                          SelectionMode="None"
                          Padding="0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ComputerProcessInfo">
                            <Grid Padding="8,5" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <!-- PID -->
                                <TextBlock Grid.Column="0" Text="{x:Bind ProcessId}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource CodeFontFamily}" />

                                <!-- Process Name -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- User -->
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayOwner}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                                <!-- CPU -->
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedCpu}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Memory -->
                                <TextBlock Grid.Column="4" Text="{x:Bind FormattedMemory}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />

                                <!-- Network -->
                                <TextBlock Grid.Column="5" Text="{x:Bind FormattedNetwork}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- Terminate Button -->
                                <Button Grid.Column="6"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanTerminate}"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="TerminateProcess_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
