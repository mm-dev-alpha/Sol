<Page
    x:Class="Sol.Views.CompareWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Sol.Helpers"
    xmlns:models="using:Sol.Models"
    xmlns:viewmodels="using:Sol.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24,16,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">

            <!-- WORKSPACE COMMAND BAR -->
            <CommandBar DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Label="{x:Bind S.CompareSwapTargetsBtn}" 
                              ToolTipService.ToolTip="{x:Bind S.CompareSwapTooltip}"
                              Command="{x:Bind ViewModel.SwapTargetsCommand}" 
                              IsEnabled="{x:Bind ViewModel.HasBothTargets, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8AB;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                
                <AppBarToggleButton Icon="Filter" 
                                    Label="{x:Bind S.CompareShowDiffsOnly}" 
                                    IsChecked="{x:Bind ViewModel.ShowDifferencesOnly, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.HasActiveComparison, Mode=OneWay}"/>

                <AppBarButton Icon="Copy" 
                              Label="{x:Bind S.CompareCopyReport}" 
                              ToolTipService.ToolTip="{x:Bind S.CompareCopyReport}"
                              Command="{x:Bind ViewModel.CopyComparisonReportCommand}" 
                              IsEnabled="{x:Bind ViewModel.HasActiveComparison, Mode=OneWay}"/>
                
                <AppBarSeparator/>

                <AppBarButton Icon="Clear" 
                              Label="{x:Bind S.CompareClearBtn}" 
                              ToolTipService.ToolTip="{x:Bind S.CompareClearBtn}"
                              Command="{x:Bind ViewModel.ClearComparisonCommand}"/>
            </CommandBar>

            <!-- PAGE TITLE & MODE SWITCHER HEADER -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind S.CompareTitle}" 
                               Style="{ThemeResource TitleLargeTextBlockStyle}" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind S.CompareSubtitle}" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Mode Switcher (Users vs Computers) -->
                <SelectorBar Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ModeSelectorBar_SelectionChanged">
                    <SelectorBarItem x:Name="UsersSelectorItem" Text="{x:Bind S.CompareModeUsers}" IsSelected="True" />
                    <SelectorBarItem x:Name="ComputersSelectorItem" Text="{x:Bind S.CompareModeComputers}" />
                </SelectorBar>
            </Grid>

            <!-- DUAL ENTITY SELECTION DECK -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TARGET A CARD -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Padding="20">
                    <Grid>
                        <!-- EMPTY STATE: AutoSuggestBox -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasTargetA, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.TargetAIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind S.CompareTargetALabel}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <AutoSuggestBox x:Name="SearchBoxA"
                                            PlaceholderText="{x:Bind ViewModel.TargetAPlaceholder, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.SuggestionsA, Mode=OneWay}"
                                            TextChanged="SearchBoxA_TextChanged"
                                            SuggestionChosen="SearchBoxA_SuggestionChosen"
                                            HorizontalAlignment="Stretch"
                                            UpdateTextOnSelect="False">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE721;"/>
                                </AutoSuggestBox.QueryIcon>
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComparisonSuggestionItem">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                        </StackPanel>

                        <!-- LOADED STATE: Rich Hero Card (User A or Computer A) -->
                        <Grid Visibility="{x:Bind ViewModel.HasTargetA, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- User A Avatar -->
                            <PersonPicture Grid.Column="0" 
                                           DisplayName="{x:Bind ViewModel.UserA.DisplayName, Mode=OneWay}" 
                                           Width="52" Height="52" Margin="0,0,16,0"
                                           Visibility="{x:Bind ViewModel.HasUserA, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Computer A Icon Badge -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" 
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" Margin="0,0,16,0"
                                    Visibility="{x:Bind ViewModel.HasComputerA, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.TargetAName, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1">
                                        <TextBlock Text="{x:Bind S.CompareTargetALabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TargetASubtitle, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TargetAOu, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind ViewModel.TargetAStatus, Mode=OneWay, Converter={StaticResource AccountStatusBrushConverter}}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TargetAStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Remove / Reset Button -->
                            <Button Grid.Column="2" 
                                    Style="{ThemeResource SubtleIconButtonStyle}" 
                                    Command="{x:Bind ViewModel.RemoveTargetACommand}"
                                    ToolTipService.ToolTip="{x:Bind S.CompareRemoveTargetTooltip}"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CENTER SWAP & BADGE COLUMN -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <Button Style="{ThemeResource SubtleIconButtonStyle}"
                            Command="{x:Bind ViewModel.SwapTargetsCommand}"
                            ToolTipService.ToolTip="{x:Bind S.CompareSwapTooltip}"
                            IsEnabled="{x:Bind ViewModel.HasBothTargets, Mode=OneWay}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8AB;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12"
                            Padding="8,2"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasActiveComparison, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.DiffCountBadgeText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- TARGET B CARD -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Padding="20">
                    <Grid>
                        <!-- EMPTY STATE: AutoSuggestBox -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasTargetB, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.TargetBIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind S.CompareTargetBLabel}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <AutoSuggestBox x:Name="SearchBoxB"
                                            PlaceholderText="{x:Bind ViewModel.TargetBPlaceholder, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.SuggestionsB, Mode=OneWay}"
                                            TextChanged="SearchBoxB_TextChanged"
                                            SuggestionChosen="SearchBoxB_SuggestionChosen"
                                            HorizontalAlignment="Stretch"
                                            UpdateTextOnSelect="False">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE721;"/>
                                </AutoSuggestBox.QueryIcon>
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComparisonSuggestionItem">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                        </StackPanel>

                        <!-- LOADED STATE: Rich Hero Card (User B or Computer B) -->
                        <Grid Visibility="{x:Bind ViewModel.HasTargetB, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- User B Avatar -->
                            <PersonPicture Grid.Column="0" 
                                           DisplayName="{x:Bind ViewModel.UserB.DisplayName, Mode=OneWay}" 
                                           Width="52" Height="52" Margin="0,0,16,0"
                                           Visibility="{x:Bind ViewModel.HasUserB, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Computer B Icon Badge -->
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" 
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" Margin="0,0,16,0"
                                    Visibility="{x:Bind ViewModel.HasComputerB, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.TargetBName, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1">
                                        <TextBlock Text="{x:Bind S.CompareTargetBLabel}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TargetBSubtitle, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TargetBOu, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind ViewModel.TargetBStatus, Mode=OneWay, Converter={StaticResource AccountStatusBrushConverter}}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TargetBStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Remove / Reset Button -->
                            <Button Grid.Column="2" 
                                    Style="{ThemeResource SubtleIconButtonStyle}" 
                                    Command="{x:Bind ViewModel.RemoveTargetBCommand}"
                                    ToolTipService.ToolTip="{x:Bind S.CompareRemoveTargetTooltip}"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- GUIDANCE CARD (Visible when fewer than 2 targets selected) -->
            <Border Visibility="{x:Bind ViewModel.HasActiveComparison, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource CardCornerRadius}"
                    Padding="44,36"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="600">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8AB;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Bind S.CompareEmptyStateTitle}" 
                               Style="{ThemeResource TitleTextBlockStyle}" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.GuidancePrompt, Mode=OneWay}" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ACTIVE COMPARISON CONTENT (Visible when both targets selected) -->
            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasActiveComparison, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- 1. SMART DISCREPANCY INSIGHTS -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasInsights, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind S.CompareInsightsTitle}" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentInsights.Count, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentInsights, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SmartInsight">
                                <controls:SettingsCard Header="{x:Bind Title}"
                                                       Description="{x:Bind Description}"
                                                       Margin="0,0,0,8">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    </controls:SettingsCard.HeaderIcon>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. GROUP MEMBERSHIP COMPARISON (VENN MATRIX) -->
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Header with Group Count Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind S.CompareGroupsTitle}" 
                                       Style="{ThemeResource SubtitleTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="10" 
                                    Padding="8,2" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.GroupTotalCount, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <SelectorBar SelectionChanged="GroupFilterSelector_SelectionChanged">
                                <SelectorBarItem Text="{x:Bind ViewModel.GroupFilterAllLabel, Mode=OneWay}" Tag="All" IsSelected="True" />
                                <SelectorBarItem Text="{x:Bind ViewModel.GroupFilterDiffsLabel, Mode=OneWay}" Tag="DifferencesOnly" />
                                <SelectorBarItem Text="{x:Bind ViewModel.GroupFilterOnlyALabel, Mode=OneWay}" Tag="OnlyInA" />
                                <SelectorBarItem Text="{x:Bind ViewModel.GroupFilterSharedLabel, Mode=OneWay}" Tag="Shared" />
                                <SelectorBarItem Text="{x:Bind ViewModel.GroupFilterOnlyBLabel, Mode=OneWay}" Tag="OnlyInB" />
                            </SelectorBar>

                            <TextBox Width="220"
                                     PlaceholderText="{x:Bind S.CompareGroupSearchPlaceholder}"
                                     Text="{x:Bind ViewModel.GroupSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.FilteredGroupItems, Mode=OneWay}"
                              MaxHeight="360"
                              SelectionMode="None"
                              BorderThickness="1"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              CornerRadius="{ThemeResource CardCornerRadius}"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:GroupDiffRow">
                                <Grid Padding="16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind GroupName}" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" 
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                            CornerRadius="10" 
                                            Padding="8,2" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind BadgeText}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- 3. ATTRIBUTE COMPARISON MATRIX -->
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Header with Property Count Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind S.ComparePropertiesTitle}" 
                                       Style="{ThemeResource SubtitleTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="10" 
                                    Padding="8,2" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.FilteredPropertyItems.Count, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBox Width="240" 
                                     PlaceholderText="{x:Bind S.ComparePropertiesSearchPlaceholder}"
                                     Text="{x:Bind ViewModel.PropertySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Column Headers Bar -->
                    <Grid Padding="16,8" ColumnSpacing="16" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind S.ComparePropertiesTitle}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TargetAName, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TargetBName, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.FilteredPropertyItems, Mode=OneWay}"
                              SelectionMode="None"
                              BorderThickness="1"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              CornerRadius="{ThemeResource CardCornerRadius}"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PropertyDiffItem">
                                <Grid Padding="16,10" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Property Header & Category Tag -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{x:Bind IsDifferent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{x:Bind PropertyName}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Category}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>

                                    <!-- Target A Value -->
                                    <Border Grid.Column="1" 
                                            Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{ThemeResource ControlCornerRadius}" 
                                            Padding="12,8">
                                        <TextBlock Text="{x:Bind ValueA}" 
                                                   Style="{ThemeResource BodyTextBlockStyle}" 
                                                   TextWrapping="Wrap" 
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>

                                    <!-- Target B Value -->
                                    <Border Grid.Column="2" 
                                            Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="{ThemeResource ControlCornerRadius}" 
                                            Padding="12,8">
                                        <TextBlock Text="{x:Bind ValueB}" 
                                                   Style="{ThemeResource BodyTextBlockStyle}" 
                                                   TextWrapping="Wrap" 
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
