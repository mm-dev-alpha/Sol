<Page
    x:Class="Sol.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Sol.ViewModels"
    xmlns:local="using:Sol.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
            
            <TextBlock Text="{x:Bind S.SettingsTitle}" Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,8"/>

            <!-- Active Directory Configuration Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.AdSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <controls:SettingsCard Header="{x:Bind S.DomainNameLabel}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="ContactInfo"/>
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox PlaceholderText="{x:Bind S.DomainNamePlaceholder}" Text="{x:Bind ViewModel.AdDomain, Mode=TwoWay}" Width="320"/>
                </controls:SettingsCard>
            </StackPanel>

            <!-- JIRA Integration Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.JiraSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <controls:SettingsExpander Header="{x:Bind S.JiraIntegrationHeader}"
                                           Description="{x:Bind S.JiraIntegrationDesc}"
                                           IsExpanded="{x:Bind ViewModel.IsJiraEnabled, Mode=TwoWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon UriSource="ms-appx:///Assets/JiraLogo.png" ShowAsMonochrome="False"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsJiraEnabled, Mode=TwoWay}"/>

                    <controls:SettingsExpander.Items>
                        <!-- Deployment Model -->
                        <controls:SettingsCard Header="{x:Bind S.JiraDeploymentModeLabel}">
                            <ComboBox ItemsSource="{x:Bind ViewModel.JiraDeploymentModes}"
                                      SelectedIndex="{x:Bind ViewModel.JiraDeploymentModeIndex, Mode=TwoWay}" 
                                      Width="260" />
                        </controls:SettingsCard>

                        <!-- Base URL -->
                        <controls:SettingsCard Header="{x:Bind S.JiraBaseUrlLabel}">
                            <TextBox PlaceholderText="{x:Bind S.JiraBaseUrlPlaceholder}" Text="{x:Bind ViewModel.JiraBaseUrl, Mode=TwoWay}" Width="320"/>
                        </controls:SettingsCard>

                        <!-- Cloud Email (Cloud only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraCloudEmailLabel}"
                                               Visibility="{x:Bind ViewModel.IsJiraCloud, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox PlaceholderText="{x:Bind S.JiraCloudEmailPlaceholder}" Text="{x:Bind ViewModel.JiraCloudEmail, Mode=TwoWay}" Width="320"/>
                        </controls:SettingsCard>

                        <!-- PAT (Data Center only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraPatLabel}"
                                               Description="{x:Bind S.JiraPatPlaceholder}"
                                               Visibility="{x:Bind ViewModel.IsJiraDataCenter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <PasswordBox x:Name="JiraPatBox" 
                                         Loaded="JiraPatBox_Loaded"
                                         PasswordChanged="JiraPatBox_PasswordChanged" 
                                         Width="320"/>
                        </controls:SettingsCard>

                        <!-- API Token (Cloud only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraApiTokenLabel}"
                                               Description="{x:Bind S.JiraApiTokenPlaceholder}"
                                               Visibility="{x:Bind ViewModel.IsJiraCloud, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <PasswordBox x:Name="JiraApiTokenBox" 
                                         Loaded="JiraApiTokenBox_Loaded"
                                         PasswordChanged="JiraApiTokenBox_PasswordChanged" 
                                         Width="320"/>
                        </controls:SettingsCard>

                        <!-- Test Connection Action -->
                        <controls:SettingsCard Header="{x:Bind S.TestJiraConnectionBtn}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsTestingJira, Mode=OneWay}" 
                                              Width="16" Height="16" 
                                              Visibility="{x:Bind ViewModel.IsTestingJira, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="{x:Bind S.TestJiraConnectionBtn}" 
                                        Command="{x:Bind ViewModel.TestJiraConnectionCommand}" 
                                        IsEnabled="{x:Bind ViewModel.IsNotTestingJira, Mode=OneWay}"
                                        Style="{ThemeResource DefaultButtonStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <!-- Tools Configuration Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.ToolsSettingsSection}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- MMC Administrative Consoles Expander -->
                <controls:SettingsExpander Header="{x:Bind S.ToolsSettingsMmcHeader}"
                                           Description="{x:Bind S.ToolsSettingsMmcDesc}"
                                           IsExpanded="{x:Bind ViewModel.IsMmcLookupEnabled, Mode=TwoWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsMmcLookupEnabled, Mode=TwoWay}"/>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.ToolsSettingsMmcHotkeyCardHeader}"
                                               Description="{x:Bind S.ToolsSettingsMmcHotkeyCardDesc}"/>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Shortcut Guide Expander -->
                <controls:SettingsExpander Header="{x:Bind S.ToolsSettingsShortcutGuideHeader}"
                                           Description="{x:Bind S.ToolsSettingsShortcutGuideDesc}"
                                           IsExpanded="{x:Bind ViewModel.IsShortcutGuideEnabled, Mode=TwoWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE765;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsShortcutGuideEnabled, Mode=TwoWay}"/>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.ToolsSettingsShortcutGuideHotkeyCardHeader}"
                                               Description="{x:Bind S.ToolsSettingsShortcutGuideHotkeyCardDesc}"/>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- File Locksmith Expander -->
                <controls:SettingsExpander Header="{x:Bind S.ToolsSettingsFileLocksmithHeader}"
                                           Description="{x:Bind S.ToolsSettingsFileLocksmithDesc}"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.ToolsSettingsFileLocksmithToggleLabel}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsFileLocksmithShellIntegrationEnabled, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Daily Admin Commands Expander -->
                <controls:SettingsExpander Header="{x:Bind S.ToolsSettingsAdminCommandsHeader}"
                                           Description="{x:Bind S.ToolsSettingsAdminCommandsDesc}"
                                           IsExpanded="{x:Bind ViewModel.IsAdminCommandsEnabled, Mode=TwoWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE756;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsAdminCommandsEnabled, Mode=TwoWay}"/>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.ToolsSettingsAdminCommandsHotkeyCardHeader}"
                                               Description="{x:Bind S.ToolsSettingsAdminCommandsHotkeyCardDesc}"/>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Grab Frame Settings -->
                <controls:SettingsExpander Header="{x:Bind S.GrabFrameSettingsHeader}"
                                           Description="{x:Bind S.GrabFrameSettingsDescription}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsGrabFrameEnabled, Mode=TwoWay}"/>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.GrabFrameSettingsAutoOcr}"
                                               Description="{x:Bind S.GrabFrameSettingsAutoOcrDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.GrabFrameAutoOcr, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind S.GrabFrameSettingsAlwaysOnTop}"
                                               Description="{x:Bind S.GrabFrameSettingsAlwaysOnTopDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.GrabFrameAlwaysOnTop, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind S.GrabFrameSettingsSingleLine}"
                                               Description="{x:Bind S.GrabFrameSettingsSingleLineDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.GrabFrameSingleLine, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind S.GrabFrameSettingsTableMode}"
                                               Description="{x:Bind S.GrabFrameSettingsTableModeDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.GrabFrameTableMode, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind S.GrabFrameSettingsAutoPaste}"
                                               Description="{x:Bind S.GrabFrameSettingsAutoPasteDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.GrabFrameAutoPaste, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Edit Text Window Settings -->
                <controls:SettingsExpander Header="{x:Bind S.EditTextSettingsHeader}"
                                           Description="{x:Bind S.EditTextSettingsDescription}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsEditTextWindowEnabled, Mode=TwoWay}"/>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind S.EditTextHotkey}"
                                               Description="{x:Bind S.ToolEditTextDesc}"/>
                        <controls:SettingsCard Header="{x:Bind S.EditTextSettingsWordWrap}"
                                               Description="{x:Bind S.EditTextSettingsWordWrapDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EditTextWindowWordWrap, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind S.EditTextSettingsAlwaysOnTop}"
                                               Description="{x:Bind S.EditTextSettingsAlwaysOnTopDesc}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.EditTextWindowAlwaysOnTop, Mode=TwoWay}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.AboutSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <controls:SettingsCard Description="{x:Bind S.DeveloperLabel}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Contact"/>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <HyperlinkButton Content="{x:Bind S.GitHubProfileLabel}" 
                                         NavigateUri="https://github.com/mm-dev-alpha" 
                                         Padding="0" 
                                         VerticalAlignment="Center"/>
                    </controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind S.AppName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind S.PipeSeparator}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind S.VersionLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Button Content="{x:Bind S.SaveSettingsBtn}" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="32,8"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
