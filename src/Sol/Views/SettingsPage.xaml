<Page
    x:Class="Sol.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Sol.ViewModels"
    xmlns:local="using:Sol.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
            
            <TextBlock Text="{x:Bind S.SettingsTitle}" Style="{ThemeResource TitleLargeTextBlockStyle}" Margin="0,0,0,8"/>

            <!-- Active Directory Configuration Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.AdSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <controls:SettingsCard Header="{x:Bind S.DomainNameLabel}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="ContactInfo"/>
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox PlaceholderText="e.g. contoso.local" Text="{x:Bind ViewModel.AdDomain, Mode=TwoWay}" Width="320"/>
                </controls:SettingsCard>
            </StackPanel>

            <!-- JIRA Integration Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.JiraSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <controls:SettingsExpander Header="{x:Bind S.JiraIntegrationHeader}"
                                           Description="{x:Bind S.JiraIntegrationDesc}"
                                           IsExpanded="{x:Bind ViewModel.IsJiraEnabled, Mode=TwoWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon UriSource="ms-appx:///Assets/JiraLogo.png" ShowAsMonochrome="False"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsJiraEnabled, Mode=TwoWay}"/>

                    <controls:SettingsExpander.Items>
                        <!-- Deployment Model -->
                        <controls:SettingsCard Header="{x:Bind S.JiraDeploymentModeLabel}">
                            <ComboBox ItemsSource="{x:Bind ViewModel.JiraDeploymentModes}"
                                      SelectedIndex="{x:Bind ViewModel.JiraDeploymentModeIndex, Mode=TwoWay}" 
                                      Width="260" />
                        </controls:SettingsCard>

                        <!-- Base URL -->
                        <controls:SettingsCard Header="{x:Bind S.JiraBaseUrlLabel}">
                            <TextBox PlaceholderText="https://jira.company.com" Text="{x:Bind ViewModel.JiraBaseUrl, Mode=TwoWay}" Width="320"/>
                        </controls:SettingsCard>

                        <!-- Cloud Email (Cloud only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraCloudEmailLabel}"
                                               Visibility="{x:Bind ViewModel.IsJiraCloud, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox PlaceholderText="user@company.com" Text="{x:Bind ViewModel.JiraCloudEmail, Mode=TwoWay}" Width="320"/>
                        </controls:SettingsCard>

                        <!-- PAT (Data Center only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraPatLabel}"
                                               Description="{x:Bind S.JiraPatPlaceholder}"
                                               Visibility="{x:Bind ViewModel.IsJiraDataCenter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <PasswordBox x:Name="JiraPatBox" 
                                         Loaded="JiraPatBox_Loaded"
                                         PasswordChanged="JiraPatBox_PasswordChanged" 
                                         Width="320"/>
                        </controls:SettingsCard>

                        <!-- API Token (Cloud only) -->
                        <controls:SettingsCard Header="{x:Bind S.JiraApiTokenLabel}"
                                               Description="{x:Bind S.JiraApiTokenPlaceholder}"
                                               Visibility="{x:Bind ViewModel.IsJiraCloud, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <PasswordBox x:Name="JiraApiTokenBox" 
                                         Loaded="JiraApiTokenBox_Loaded"
                                         PasswordChanged="JiraApiTokenBox_PasswordChanged" 
                                         Width="320"/>
                        </controls:SettingsCard>

                        <!-- Test Connection Action -->
                        <controls:SettingsCard Header="{x:Bind S.TestJiraConnectionBtn}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsTestingJira, Mode=OneWay}" 
                                              Width="16" Height="16" 
                                              Visibility="{x:Bind ViewModel.IsTestingJira, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="{x:Bind S.TestJiraConnectionBtn}" 
                                        Command="{x:Bind ViewModel.TestJiraConnectionCommand}" 
                                        IsEnabled="{x:Bind ViewModel.IsNotTestingJira, Mode=OneWay}"
                                        Style="{ThemeResource DefaultButtonStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- Inline Feedback InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsJiraTestStatusOpen, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.JiraTestStatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.JiraTestStatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         Margin="0,0,0,0"/>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind S.AboutSettings}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <controls:SettingsCard Description="{x:Bind S.DeveloperLabel}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Contact"/>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <HyperlinkButton Content="{x:Bind S.GitHubProfileLabel}" 
                                         NavigateUri="https://github.com/mm-dev-alpha" 
                                         Padding="0" 
                                         VerticalAlignment="Center"/>
                    </controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Sol" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="|" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind S.VersionLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Button Content="{x:Bind S.SaveSettingsBtn}" Command="{x:Bind ViewModel.SaveCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="32,8"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
