<Page
    x:Class="Sol.Views.RdsWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Sol.Models"
    xmlns:helpers="using:Sol.Helpers"
    xmlns:local="using:Sol.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Warning Banners (Missing Broker or Elevation) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Active Tab Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Header & Sub-Navigation SelectorBar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <!-- Page Title & Icon on Left -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE7F4;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind S.NavRdsWorkspace}" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.ConnectionBroker, Mode=OneWay}" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- SelectorBar (Sessions vs Profile Disks) Truly Centered -->
            <SelectorBar HorizontalAlignment="Center" VerticalAlignment="Center"
                         SelectionChanged="TabSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="SessionsSelectorItem" Text="{x:Bind S.RdsTabSessions}" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <SymbolIcon Symbol="People"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ProfileDisksSelectorItem" Text="{x:Bind S.RdsTabProfileDisks}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xEDA2;"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- Settings Shortcut Button on Right -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SubtleIconButtonStyle}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="{x:Bind S.NavSettings}">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 1. Warning Cards (Elevation & Missing Broker) -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <!-- Missing Broker Warning -->
            <Border Visibility="{x:Bind ViewModel.MissingBrokerWarningVisibility, Mode=OneWay}"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind S.RdsBrokerRequiredPrompt}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind S.RdsSettingsBrokerDesc}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Bind S.NavSettings}" Command="{x:Bind ViewModel.OpenSettingsCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Elevation Warning with 1-Click Restart as Administrator -->
            <Border Visibility="{x:Bind ViewModel.ElevationWarningVisibility, Mode=OneWay}"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7EF;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind S.RdsUpdElevationRequiredTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind S.RdsUpdElevationRequiredDesc}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" 
                            Command="{x:Bind ViewModel.RestartAsAdministratorCommand}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7EF;" FontSize="14"/>
                            <TextBlock Text="{x:Bind S.RdsUpdRestartAsAdminBtn}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 2. Main Content Grid (Tab 0: Sessions, Tab 1: Profile Disks) -->
        <Grid Grid.Row="2">

            <!-- ================= SESSIONS VIEW ================= -->
            <Grid x:Name="SessionsContainer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter & Action Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <!-- Search Filter on Left -->
                    <TextBox HorizontalAlignment="Left" VerticalAlignment="Center"
                             PlaceholderText="{x:Bind S.RdsSessionsFilterPlaceholder}"
                             Text="{x:Bind ViewModel.SessionFilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="320"/>

                    <!-- Status Badges Truly Centered in Toolbar -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Orientation="Horizontal" Spacing="8">
                        <!-- Total Count Pill -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalSessionsBadge, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Active Count Pill -->
                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveSessionsBadge, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Connected Count Pill -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ConnectedSessionsBadgeVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ConnectedSessionsBadge, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Disconnected Count Pill -->
                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.DisconnectedSessionsBadge, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Top Action Buttons on Right -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Spacing="8">
                        <Button Click="DisconnectSelected_Click"
                                Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEECA;" FontSize="12"/>
                                <TextBlock Text="{x:Bind S.RdsSessionsDisconnectBtn}"/>
                            </StackPanel>
                        </Button>

                        <Button Click="LogoffSelected_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF3B1;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="{x:Bind S.RdsSessionsLogoffBtn}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.RefreshSessionsCommand}"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind S.RdsSessionsRefreshBtn}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Error State Card -->
                <controls:SettingsCard Grid.Row="1"
                                       Header="{x:Bind S.RdsSessionsErrorCardTitle}"
                                       Description="{x:Bind ViewModel.SessionsErrorMessage, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasSessionsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Margin="0,0,0,12">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="{x:Bind S.RdsSessionsRetryBtn}"
                            Command="{x:Bind ViewModel.RefreshSessionsCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </controls:SettingsCard>

                <!-- Column Headers -->
                <Border Grid.Row="2"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Username -->
                        <Button Grid.Column="0" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="Username" Padding="4,2" ToolTipService.ToolTip="{x:Bind S.RdsSessionsSortUsername}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind S.RdsSessionsColUsername}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="SortIcon_Username" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Col 1: State -->
                        <Button Grid.Column="1" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="State" Padding="4,2" ToolTipService.ToolTip="{x:Bind S.RdsSessionsSortState}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind S.RdsSessionsColState}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="SortIcon_State" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Col 2: Host Server -->
                        <Button Grid.Column="2" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="HostServer" Padding="4,2" ToolTipService.ToolTip="{x:Bind S.RdsSessionsSortServer}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind S.RdsSessionsColServer}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="SortIcon_HostServer" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Col 3: Session ID -->
                        <Button Grid.Column="3" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="SessionId" Padding="4,2" ToolTipService.ToolTip="{x:Bind S.RdsSessionsSortId}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind S.RdsSessionsColSessionId}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="SortIcon_SessionId" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Col 4: Logon Time -->
                        <Button Grid.Column="4" Style="{StaticResource SubtleIconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SortColumn_Click" Tag="LogonTime" Padding="4,2" ToolTipService.ToolTip="{x:Bind S.RdsSessionsSortLogon}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind S.RdsSessionsColLogonTime}" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                <TextBlock x:Name="SortIcon_LogonTime" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Col 5: Actions Header -->
                        <TextBlock Grid.Column="5" Text="" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Sessions ListView -->
                <Grid Grid.Row="3">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="SessionsListView"
                                  ItemsSource="{x:Bind ViewModel.FilteredSessions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                  SelectionMode="Extended"
                                  DoubleTapped="SessionsListView_DoubleTapped"
                                  Padding="0,4">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="MinHeight" Value="42"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RdsSessionItem">
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: User & Domain -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PersonPicture DisplayName="{x:Bind Username}" Width="24" Height="24"/>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Domain}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 1: Status Pill -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Active State Pill -->
                                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                    Visibility="{x:Bind IsActive, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind DisplayState}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Connected State Pill -->
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                    Visibility="{x:Bind IsConnected, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind DisplayState}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Disconnected State Pill -->
                                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                    Visibility="{x:Bind IsDisconnected, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind DisplayState}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Other / Unknown State Pill -->
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                    Visibility="{x:Bind IsOtherState, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind DisplayState}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Col 2: Server Host -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F8;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind HostServer}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Col 3: Session ID -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind SessionId}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- Col 4: Logon Time -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedLogonTime}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- Col 5: Quick Action Buttons -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Tag="{x:Bind}" Click="RowDisconnect_Click"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind local:Strings.S.RdsSessionsDisconnectBtn}">
                                                <FontIcon Glyph="&#xEECA;" FontSize="12"/>
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="RowLogoff_Click"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind local:Strings.S.RdsSessionsLogoffBtn}">
                                                <FontIcon Glyph="&#xF3B1;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Loading Overlay -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing IsActive="True" Width="36" Height="36"/>
                        <TextBlock Text="{x:Bind S.LoadingPrompt}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasNoSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE777;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind S.RdsSessionsEmptyStateTitle}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind S.RdsSessionsEmptyStateDesc}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>


            <!-- ================= USER PROFILE DISKS (UPD) VIEW ================= -->
            <ScrollViewer x:Name="ProfileDisksContainer" Visibility="Collapsed"
                          Padding="0,4" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">

                    <!-- Card 1: User Account -->
                    <controls:SettingsCard Header="{x:Bind S.RdsUpdSelectUserHeader}"
                                           Description="{x:Bind S.RdsUpdSelectUserDesc}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- AD User AutoSuggestBox -->
                            <AutoSuggestBox PlaceholderText="{x:Bind S.RdsUpdSearchUserPlaceholder}"
                                            Text="{x:Bind ViewModel.UserSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{x:Bind ViewModel.UserSuggestions, Mode=OneWay}"
                                            TextChanged="UserSearchBox_TextChanged"
                                            SuggestionChosen="UserSearchBox_SuggestionChosen"
                                            QuerySubmitted="UserSearchBox_QuerySubmitted"
                                            Width="360"
                                            UpdateTextOnSelect="False">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon Glyph="&#xE77B;"/>
                                </AutoSuggestBox.QueryIcon>
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdUser">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                            <PersonPicture DisplayName="{x:Bind DisplayName}" Width="28" Height="28"/>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind SamAccountName}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>

                            <!-- Selected User Badge Pill -->
                            <Border Visibility="{x:Bind ViewModel.HasSelectedUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedUser.SamAccountName, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Card 2: Session Collection -->
                    <controls:SettingsCard Header="{x:Bind S.RdsUpdCollectionHeader}"
                                           Description="{x:Bind S.RdsUpdCollectionDesc}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEDA2;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- Collection Dropdown -->
                            <ComboBox ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                                      DisplayMemberPath="CollectionName"
                                      PlaceholderText="{x:Bind S.RdsUpdSelectCollectionPlaceholder}"
                                      Width="280"/>
                            <!-- Loading ProgressRing -->
                            <ProgressRing IsActive="{x:Bind GetIsLoadingRingActive(ViewModel.IsLoadingCollections, ViewModel.IsLoadingCollectionConfig), Mode=OneWay}"
                                          Visibility="{x:Bind GetLoadingRingVisibility(ViewModel.IsLoadingCollections, ViewModel.IsLoadingCollectionConfig), Mode=OneWay}"
                                          Width="16" Height="16"/>
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    Command="{x:Bind ViewModel.LoadCollectionsCommand}"
                                    ToolTipService.ToolTip="{x:Bind S.RdsUpdRefreshCollectionsBtn}">
                                <FontIcon Glyph="&#xE72C;"/>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Error State Card: Failed to Query Collections -->
                    <controls:SettingsCard Header="{x:Bind S.RdsUpdCollectionsErrorTitle}"
                                           Description="{x:Bind ViewModel.CollectionsErrorMessage, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasCollectionsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="{x:Bind S.RdsSessionsRetryBtn}"
                                Command="{x:Bind ViewModel.LoadCollectionsCommand}"
                                Style="{ThemeResource AccentButtonStyle}"/>
                    </controls:SettingsCard>

                    <!-- Warning: No Collections Found -->
                    <Border Visibility="{x:Bind GetNoCollectionsWarningVisibility(ViewModel.Collections.Count, ViewModel.IsLoadingCollections, ViewModel.HasCollectionsError), Mode=OneWay}"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind S.RdsUpdNoCollectionsFound}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="{x:Bind S.RdsSessionsRetryBtn}"
                                    Command="{x:Bind ViewModel.LoadCollectionsCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Warning: UPD Not Configured for Selected Collection -->
                    <Border Visibility="{x:Bind GetUpdNotEnabledWarningVisibility(ViewModel.SelectedCollection, ViewModel.IsLoadingCollectionConfig), Mode=OneWay}"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind S.RdsUpdNotEnabledWarning}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Conflicting Session Warning Card -->
                    <Border Visibility="{x:Bind ViewModel.HasConflictingSessions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind S.RdsUpdSessionConflictTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind S.RdsUpdSessionConflictDesc}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{x:Bind S.RdsUpdLogoffUserSessionsBtn}"
                                    Command="{x:Bind ViewModel.LogoffConflictingSessionsCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Disk Inspection Card -->
                    <controls:SettingsExpander Header="{x:Bind S.RdsUpdDiskInfoTitle}"
                                               IsExpanded="True"
                                               Visibility="{x:Bind ViewModel.HasDisk, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEDA2;"/>
                        </controls:SettingsExpander.HeaderIcon>

                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <!-- Capacity Badge -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.DiskLayout.CapacityGiB, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind S.RdsGiBSuffix}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- File Lock Status Badge -->
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4"
                                    Visibility="{x:Bind ViewModel.DiskLayout.IsFileLocked, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind S.RdsUpdFileAvailable}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,4"
                                    Visibility="{x:Bind ViewModel.DiskLayout.IsFileLocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind S.RdsUpdFileLocked}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <controls:SettingsExpander.Items>
                            <!-- VHDX Share Path -->
                            <controls:SettingsCard Header="{x:Bind S.RdsUpdPathLabel}">
                                <TextBox Text="{x:Bind ViewModel.DiskLayout.VhdxPath, Mode=OneWay}" IsReadOnly="True" Width="480"/>
                            </controls:SettingsCard>

                            <!-- Partition Style -->
                            <controls:SettingsCard Header="{x:Bind S.RdsUpdPartitionStyleLabel}">
                                <TextBlock Text="{x:Bind ViewModel.DiskLayout.PartitionStyle, Mode=OneWay}" FontWeight="SemiBold"/>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- Disk Missing Notice -->
                    <Border Visibility="{x:Bind ViewModel.IsDiskMissing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE783;" FontSize="28" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind S.RdsUpdFileMissing}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.DiskLayout.ErrorMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Expand Disk Configuration Card -->
                    <controls:SettingsCard Header="{x:Bind S.RdsUpdExpandHeader}"
                                           Visibility="{x:Bind ViewModel.HasDisk, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B9;"/>
                        </controls:SettingsCard.HeaderIcon>

                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind S.RdsUpdGiBToAddLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <NumberBox Value="{x:Bind ViewModel.AdditionalGiB, Mode=TwoWay}"
                                       Minimum="1" Maximum="1024"
                                       SpinButtonPlacementMode="Inline" Width="140"/>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{x:Bind S.RdsUpdTargetCapacityLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TargetGiB, Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind S.RdsGiBSuffix}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button Content="{x:Bind S.RdsUpdExpandBtn}"
                                    Click="ExpandDisk_Click"
                                    IsEnabled="{x:Bind ViewModel.CanExpand, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Stepped Expansion Progress Card -->
                    <Border Visibility="{x:Bind ViewModel.IsExpanding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing IsActive="True" Width="20" Height="20"/>
                                <TextBlock Text="{x:Bind ViewModel.ExpansionStepDescription, Mode=OneWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
