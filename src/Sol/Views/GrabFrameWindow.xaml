<Window
    x:Class="Sol.Views.GrabFrameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Sol.Helpers"
    xmlns:models="using:Sol.Models"
    Title="Grab Frame"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!-- Top TitleBar / Control Strip -->
        <Grid
            x:Name="TopBarGrid"
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="WindowTitleTextBlock"
                    Text="{x:Bind S.ToolGrabFrameTitle}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status Badge / Notification Pill -->
            <Border
                x:Name="StatusPill"
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="8,2"
                CornerRadius="10"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="StatusPillText"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <!-- Top Right Action Controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Auto-OCR Toggle -->
                <ToggleButton
                    x:Name="AutoOcrToggleButton"
                    Width="30"
                    Height="28"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameAutoOcrTooltip}"
                    Click="AutoOcrToggleButton_Click">
                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                </ToggleButton>

                <!-- Always on Top Toggle -->
                <ToggleButton
                    x:Name="AlwaysOnTopToggleButton"
                    Width="30"
                    Height="28"
                    Padding="0"
                    IsChecked="True"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameAlwaysOnTopTooltip}"
                    Click="AlwaysOnTopToggleButton_Click">
                    <FontIcon Glyph="&#xE718;" FontSize="12" />
                </ToggleButton>

                <!-- Close Button -->
                <Button
                    x:Name="CloseWindowButton"
                    Width="30"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameCloseTooltip}"
                    Click="CloseWindowButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Center Viewfinder Area -->
        <Border
            x:Name="ViewfinderBorder"
            Grid.Row="1"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            Background="Transparent">
            <Grid x:Name="ViewfinderContentGrid">
                <!-- Freeze-frame Image -->
                <Image
                    x:Name="FrozenImageView"
                    Stretch="Fill"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed" />

                <!-- Recognized Word Overlays Canvas -->
                <Canvas
                    x:Name="WordBordersCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />

                <!-- Draggable Table Column Dividers Canvas -->
                <Canvas
                    x:Name="TableDividersCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Visibility="Collapsed"
                    PointerPressed="TableDividersCanvas_PointerPressed"
                    PointerMoved="TableDividersCanvas_PointerMoved"
                    PointerReleased="TableDividersCanvas_PointerReleased"
                    PointerCanceled="TableDividersCanvas_PointerCanceled" />

                <!-- Hint Banner in Table Mode -->
                <Border
                    x:Name="TableModeHintBanner"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Padding="10,4"
                    CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock
                        Text="{x:Bind S.GrabFrameAddDividerHint}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Toolbar -->
        <Grid
            x:Name="BottomToolbarGrid"
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Area (Column 0: Search Box & Match Count) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBox
                    x:Name="SearchTextBox"
                    Width="140"
                    Height="32"
                    VerticalAlignment="Center"
                    PlaceholderText="{x:Bind S.GrabFrameSearchPlaceholder}"
                    TextChanged="SearchTextBox_TextChanged" />
                <TextBlock
                    x:Name="MatchCountTextBlock"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind S.GrabFrameNoMatches}" />
            </StackPanel>

            <!-- Language ComboBox (Column 1) -->
            <ComboBox
                x:Name="LanguageComboBox"
                Grid.Column="1"
                Height="32"
                MinWidth="100"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                SelectionChanged="LanguageComboBox_SelectionChanged" />

            <!-- Secondary Actions (Column 2) -->
            <StackPanel x:Name="SecondaryActionsStack" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
                <!-- Re-OCR Button -->
                <Button
                    x:Name="RefreshButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameRefreshTooltip}"
                    Click="RefreshButton_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>

                <!-- Freeze Toggle -->
                <ToggleButton
                    x:Name="FreezeToggleButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameFreezeTooltip}"
                    Click="FreezeToggleButton_Click">
                    <FontIcon Glyph="&#xE769;" FontSize="13" />
                </ToggleButton>

                <!-- Table Mode Toggle -->
                <ToggleButton
                    x:Name="TableToggleButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameTableTooltip}"
                    Click="TableToggleButton_Click">
                    <FontIcon Glyph="&#xE8C0;" FontSize="13" />
                </ToggleButton>

                <!-- Single Line Toggle -->
                <ToggleButton
                    x:Name="SingleLineToggleButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind S.GrabFrameSingleLineTooltip}"
                    Click="SingleLineToggleButton_Click">
                    <FontIcon Glyph="&#xE8D2;" FontSize="13" />
                </ToggleButton>
            </StackPanel>

            <!-- Grab Action Button (Column 3) ALWAYS on the far right -->
            <Button
                x:Name="GrabActionButton"
                Grid.Column="3"
                Height="32"
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{ThemeResource AccentButtonStyle}"
                ToolTipService.ToolTip="{x:Bind S.GrabFrameGrabTooltip}"
                Click="GrabActionButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                    <TextBlock x:Name="GrabButtonTextBlock" Text="{x:Bind S.GrabFrameGrabButton}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
